# Copie este arquivo para ".env" e ajuste o que precisar.
# Sem nenhuma alteração o projeto já roda com a IA simulada.

# Banco de dados (SQLite local por padrão)
DATABASE_URL=sqlite:///./chamados.db

# IA generativa: "simulado" (sem custo, sem chave) ou "anthropic"
PROVEDOR_IA=simulado
ANTHROPIC_API_KEY=
MODELO_IA=claude-haiku-4-5-20251001

# Sistema corporativo externo (ITSM simulado)
ITSM_BASE_URL=http://localhost:8001
ITSM_SEGREDO_WEBHOOK=troque-este-segredo
ITSM_TIMEOUT_SEGUNDOS=3
