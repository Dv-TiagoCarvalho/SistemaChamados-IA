    "/api/webhooks/itsm": {
      "post": {
        "tags": [
          "integracao"
        ],
        "summary": "Receber Webhook Itsm",
        "description": "Recebe a mudança de estado de um incidente.\n\nO cabeçalho `X-Assinatura` deve conter `sha256=<HMAC-SHA256 do corpo>`\ncalculado com o segredo compartilhado. Sem isso, qualquer pessoa que\ndescobrisse a URL poderia alterar chamados.",
        "operationId": "receber_webhook_itsm_api_webhooks_itsm_post",
        "parameters": [
          {
            "name": "x-assinatura",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Assinatura"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChamadoResumo"
                }
              }
            }
          },
          "401": {
            "description": "Assinatura ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Nenhum chamado com esse id externo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "422": {
            "description": "Corpo ou estado inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    }
