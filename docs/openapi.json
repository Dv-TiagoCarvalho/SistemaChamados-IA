    "/api/saude": {
      "get": {
        "tags": [
          "sistema"
        ],
        "summary": "Saude",
        "description": "Usado por monitoramento para saber se a API está de pé.",
        "operationId": "saude_api_saude_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saude"
                }
              }
            }
          }
        }
      }
    },
