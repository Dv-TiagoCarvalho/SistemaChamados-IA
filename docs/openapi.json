    "/api/chamados": {
      "post": {
        "tags": [
          "chamados"
        ],
        "summary": "Criar Chamado",
        "description": "Abre um chamado: classifica com IA, calcula o prazo e registra no ITSM.",
        "operationId": "criar_chamado_api_chamados_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChamadoCriar"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChamadoDetalhe"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "chamados"
        ],
        "summary": "Listar Chamados",
        "description": "Lista os chamados: em andamento primeiro, do prazo mais próximo ao mais distante.",
        "operationId": "listar_chamados_api_chamados_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Status"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "prioridade",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Prioridade"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Prioridade"
            }
          },
          {
            "name": "categoria",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Categoria"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Categoria"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChamadoResumo"
